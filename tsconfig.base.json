{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@wm/shared/domain": ["./libs/shared/domain/src/index.ts"],
      "@wm/shared/util-dates": ["./libs/shared/util-dates/src/index.ts"],
      "@wm/shared/data-access-logging": [
        "./libs/shared/data-access-logging/src/index.ts"
      ],
      "@wm/shared/data-access-toasts": [
        "./libs/shared/data-access-toasts/src/index.ts"
      ],
      "@wm/shared/data-access-auth": [
        "./libs/shared/data-access-auth/src/index.ts"
      ],
      "@wm/shared/data-access-messaging": [
        "./libs/shared/data-access-messaging/src/index.ts"
      ],
      "@wm/shared/ui-design-system": [
        "./libs/shared/ui-design-system/src/index.ts"
      ],
      "@wm/monitoring/data-access": [
        "./libs/monitoring/data-access/src/index.ts"
      ],
      "@wm/monitoring/ui": ["./libs/monitoring/ui/src/index.ts"],
      "@wm/monitoring/domain": ["./libs/monitoring/domain/src/index.ts"],
      "@wm/monitoring/feature-station": [
        "./libs/monitoring/feature-station/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
